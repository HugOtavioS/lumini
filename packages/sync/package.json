{
  "name": "@lumini/sync",
  "version": "0.1.0",
  "private": true,
  "description": "Sincronização offline do Lumini: fila persistente com retry e backoff, resolução de conflitos com log de auditoria, política de armazenamento local e servidor de referência para os testes.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:detalhado": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.testes.json",
    "demo": "tsx --disable-warning=ExperimentalWarning scripts/demonstracao.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
