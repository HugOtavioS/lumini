{
  "name": "@lumini/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Regras de cálculo compartilhadas entre o app mobile e o painel web (dimensionamento, alertas, compatibilidade elétrica, HSP, trajetória solar, sombreamento e calibração da RA).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:detalhado": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "demo": "tsx scripts/demonstracao.ts",
    "demo:sem-internet": "tsx scripts/demonstracao.ts --sem-internet",
    "exemplo-sombreamento": "tsx scripts/gerar-exemplo-sombreamento.ts",
    "importar-atlas": "tsx scripts/importar-atlas-labren.ts",
    "calibracao": "tsx scripts/analisar-calibracao.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
