# Copie para apps/api/.env na EC2 e preencha. NÃO suba este arquivo preenchido para o Git.
NODE_ENV=production
PORT=3000
# Endpoint do RDS (console do RDS > Connectivity & security). Senha com @ : / # etc. precisa ser codificada (ex.: @ vira %40).
DATABASE_URL=postgres://USUARIO:SENHA@ENDPOINT.rds.amazonaws.com:5432/lumini
DB_SSL=sim
# Gere com: openssl rand -hex 32
JWT_SECRET=TROQUE-POR-UM-SEGREDO-LONGO
# Cria a empresa de demonstração (usuários com senha lumini123) se o banco estiver vazio.
LUMINI_SEED=sim
