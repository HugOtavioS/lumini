{
  "name": "lumini",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo do Lumini — app mobile, painel web, API e pacotes compartilhados.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:detalhado": "npm run test:detalhado --workspaces --if-present",
    "demo": "npm run demo -w @lumini/domain",
    "demo:sem-internet": "npm run demo:sem-internet -w @lumini/domain",
    "demo:sync": "npm run demo -w @lumini/sync",
    "api": "npm run start -w @lumini/api",
    "painel": "npm run dev -w @lumini/web"
  },
  "engines": {
    "node": ">=22.13"
  }
}
